{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Financial balance sheet sandbox facts",
  "type": "object",
  "properties": {
    "documentReference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "issuedOn": {
      "type": "string",
      "format": "date"
    },
    "partyName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "resourceReference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "system": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "resourceReference": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "observedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "system",
          "resourceReference",
          "version",
          "observedAt"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 6
    },
    "currency": {
      "const": "USD"
    },
    "reportingDate": {
      "type": "string",
      "format": "date"
    },
    "comparativeDate": {
      "type": "string",
      "format": "date"
    },
    "reportingBasis": {
      "const": "SANDBOX_MANAGEMENT_BASIS"
    },
    "consolidationScope": {
      "const": "SINGLE_FICTIONAL_ENTITY"
    },
    "approvalStatus": {
      "const": "UNAUDITED_SANDBOX"
    },
    "periodReference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "reconciliationReference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "current": {
      "type": "object",
      "properties": {
        "cash": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]{2}$",
          "maxLength": 32
        },
        "customerLoans": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]{2}$",
          "maxLength": 32
        },
        "investments": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]{2}$",
          "maxLength": 32
        },
        "totalAssets": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]{2}$",
          "maxLength": 32
        },
        "customerDeposits": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]{2}$",
          "maxLength": 32
        },
        "borrowings": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]{2}$",
          "maxLength": 32
        },
        "totalLiabilities": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]{2}$",
          "maxLength": 32
        },
        "shareCapital": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]{2}$",
          "maxLength": 32
        },
        "retainedEarnings": {
          "type": "string",
          "pattern": "^-?[0-9]+\\.[0-9]{2}$",
          "maxLength": 32
        },
        "totalEquity": {
          "type": "string",
          "pattern": "^-?[0-9]+\\.[0-9]{2}$",
          "maxLength": 32
        },
        "totalLiabilitiesAndEquity": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]{2}$",
          "maxLength": 32
        }
      },
      "required": [
        "cash",
        "customerLoans",
        "investments",
        "totalAssets",
        "customerDeposits",
        "borrowings",
        "totalLiabilities",
        "shareCapital",
        "retainedEarnings",
        "totalEquity",
        "totalLiabilitiesAndEquity"
      ],
      "additionalProperties": false
    },
    "comparative": {
      "type": "object",
      "properties": {
        "cash": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]{2}$",
          "maxLength": 32
        },
        "customerLoans": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]{2}$",
          "maxLength": 32
        },
        "investments": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]{2}$",
          "maxLength": 32
        },
        "totalAssets": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]{2}$",
          "maxLength": 32
        },
        "customerDeposits": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]{2}$",
          "maxLength": 32
        },
        "borrowings": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]{2}$",
          "maxLength": 32
        },
        "totalLiabilities": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]{2}$",
          "maxLength": 32
        },
        "shareCapital": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]{2}$",
          "maxLength": 32
        },
        "retainedEarnings": {
          "type": "string",
          "pattern": "^-?[0-9]+\\.[0-9]{2}$",
          "maxLength": 32
        },
        "totalEquity": {
          "type": "string",
          "pattern": "^-?[0-9]+\\.[0-9]{2}$",
          "maxLength": 32
        },
        "totalLiabilitiesAndEquity": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]{2}$",
          "maxLength": 32
        }
      },
      "required": [
        "cash",
        "customerLoans",
        "investments",
        "totalAssets",
        "customerDeposits",
        "borrowings",
        "totalLiabilities",
        "shareCapital",
        "retainedEarnings",
        "totalEquity",
        "totalLiabilitiesAndEquity"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "documentReference",
    "issuedOn",
    "partyName",
    "resourceReference",
    "sources",
    "currency",
    "reportingDate",
    "comparativeDate",
    "reportingBasis",
    "consolidationScope",
    "approvalStatus",
    "periodReference",
    "reconciliationReference",
    "current",
    "comparative"
  ],
  "additionalProperties": false
}
