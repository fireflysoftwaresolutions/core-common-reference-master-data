{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Claim settlement statement sandbox facts",
  "type": "object",
  "properties": {
    "documentReference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "issuedOn": {
      "type": "string",
      "format": "date"
    },
    "partyName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "resourceReference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "currency": {
      "const": "USD"
    },
    "claimNumber": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "policyNumber": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "lossDate": {
      "type": "string",
      "format": "date"
    },
    "decisionReference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "grossApproved": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]{2}$",
      "maxLength": 32
    },
    "deductible": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]{2}$",
      "maxLength": 32
    },
    "retainedDepreciation": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]{2}$",
      "maxLength": 32
    },
    "priorPayments": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]{2}$",
      "maxLength": 32
    },
    "netSettlement": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]{2}$",
      "maxLength": 32
    },
    "settlementState": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "paymentReference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "evidenceReference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "assessment": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "approved": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]{2}$",
            "maxLength": 32
          },
          "coverageCode": {
            "enum": [
              "BUILDINGS",
              "CONTENTS"
            ]
          }
        },
        "required": [
          "description",
          "approved",
          "coverageCode"
        ],
        "additionalProperties": false
      }
    },
    "deductibleRuleCode": {
      "const": "HIGHEST_APPLICABLE_ONCE"
    },
    "deductibleRuleReference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    }
  },
  "required": [
    "documentReference",
    "issuedOn",
    "partyName",
    "resourceReference",
    "currency",
    "claimNumber",
    "policyNumber",
    "lossDate",
    "decisionReference",
    "grossApproved",
    "deductible",
    "retainedDepreciation",
    "priorPayments",
    "netSettlement",
    "settlementState",
    "paymentReference",
    "evidenceReference",
    "assessment",
    "deductibleRuleCode",
    "deductibleRuleReference"
  ],
  "additionalProperties": false
}
