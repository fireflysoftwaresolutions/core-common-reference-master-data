{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Installment loan agreement sandbox facts",
  "type": "object",
  "properties": {
    "documentReference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "issuedOn": {
      "type": "string",
      "format": "date"
    },
    "partyName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "resourceReference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "currency": {
      "const": "USD"
    },
    "agreementNumber": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "principal": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]{2}$",
      "maxLength": 32
    },
    "annualRate": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "aprDisplay": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "financeCharge": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]{2}$",
      "maxLength": 32
    },
    "totalPayments": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]{2}$",
      "maxLength": 32
    },
    "installment": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]{2}$",
      "maxLength": 32
    },
    "term": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "effectiveDate": {
      "type": "string",
      "format": "date"
    },
    "firstDueDate": {
      "type": "string",
      "format": "date"
    },
    "finalDueDate": {
      "type": "string",
      "format": "date"
    },
    "lateFee": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]{2}$",
      "maxLength": 32
    },
    "governingTerms": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "repaymentReference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "signatureState": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "schedule": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "properties": {
          "number": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "dueDate": {
            "type": "string",
            "format": "date"
          },
          "principal": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]{2}$",
            "maxLength": 32
          },
          "interest": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]{2}$",
            "maxLength": 32
          },
          "payment": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]{2}$",
            "maxLength": 32
          },
          "closingPrincipal": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]{2}$",
            "maxLength": 32
          },
          "openingPrincipal": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]{2}$",
            "maxLength": 32
          }
        },
        "required": [
          "number",
          "dueDate",
          "principal",
          "interest",
          "payment",
          "closingPrincipal",
          "openingPrincipal"
        ],
        "additionalProperties": false
      }
    },
    "interestBasis": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    }
  },
  "required": [
    "documentReference",
    "issuedOn",
    "partyName",
    "resourceReference",
    "currency",
    "agreementNumber",
    "principal",
    "annualRate",
    "aprDisplay",
    "financeCharge",
    "totalPayments",
    "installment",
    "term",
    "effectiveDate",
    "firstDueDate",
    "finalDueDate",
    "lateFee",
    "governingTerms",
    "repaymentReference",
    "signatureState",
    "schedule",
    "interestBasis"
  ],
  "additionalProperties": false
}
