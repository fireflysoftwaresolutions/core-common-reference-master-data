{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Commercial property policy declarations sandbox facts",
  "type": "object",
  "properties": {
    "documentReference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "issuedOn": {
      "type": "string",
      "format": "date"
    },
    "partyName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "resourceReference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "currency": {
      "const": "USD"
    },
    "policyNumber": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "riskAddress": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "effectiveDate": {
      "type": "string",
      "format": "date"
    },
    "expiryDate": {
      "type": "string",
      "format": "date"
    },
    "occurrenceLimit": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]{2}$",
      "maxLength": 32
    },
    "annualPremium": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]{2}$",
      "maxLength": 32
    },
    "tax": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]{2}$",
      "maxLength": 32
    },
    "totalPremium": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]{2}$",
      "maxLength": 32
    },
    "policyState": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "brokerReference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "wordingReference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "endorsements": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "coverages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "properties": {
          "coverage": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "limit": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]{2}$",
            "maxLength": 32
          },
          "deductible": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]{2}$",
            "maxLength": 32
          },
          "basis": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "code": {
            "enum": [
              "BUILDINGS",
              "CONTENTS",
              "BUSINESS_INTERRUPTION"
            ]
          }
        },
        "required": [
          "coverage",
          "limit",
          "deductible",
          "basis",
          "code"
        ],
        "additionalProperties": false
      }
    },
    "deductibleRuleCode": {
      "const": "HIGHEST_APPLICABLE_ONCE"
    }
  },
  "required": [
    "documentReference",
    "issuedOn",
    "partyName",
    "resourceReference",
    "currency",
    "policyNumber",
    "riskAddress",
    "effectiveDate",
    "expiryDate",
    "occurrenceLimit",
    "annualPremium",
    "tax",
    "totalPremium",
    "policyState",
    "brokerReference",
    "wordingReference",
    "endorsements",
    "coverages",
    "deductibleRuleCode"
  ],
  "additionalProperties": false
}
