{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Account statement sandbox facts",
  "type": "object",
  "properties": {
    "documentReference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "issuedOn": {
      "type": "string",
      "format": "date"
    },
    "partyName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "resourceReference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "currency": {
      "const": "USD"
    },
    "accountNumber": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "periodStart": {
      "type": "string",
      "format": "date"
    },
    "periodEnd": {
      "type": "string",
      "format": "date"
    },
    "openingBalance": {
      "type": "string",
      "pattern": "^-?[0-9]+\\.[0-9]{2}$",
      "maxLength": 32
    },
    "closingBalance": {
      "type": "string",
      "pattern": "^-?[0-9]+\\.[0-9]{2}$",
      "maxLength": 32
    },
    "totalDebits": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]{2}$",
      "maxLength": 32
    },
    "totalCredits": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]{2}$",
      "maxLength": 32
    },
    "contactReference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "rateNote": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "movements": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "debit": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]{2}$",
            "maxLength": 32
          },
          "credit": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]{2}$",
            "maxLength": 32
          },
          "balance": {
            "type": "string",
            "pattern": "^-?[0-9]+\\.[0-9]{2}$",
            "maxLength": 32
          }
        },
        "required": [
          "date",
          "description",
          "debit",
          "credit",
          "balance"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "documentReference",
    "issuedOn",
    "partyName",
    "resourceReference",
    "currency",
    "accountNumber",
    "periodStart",
    "periodEnd",
    "openingBalance",
    "closingBalance",
    "totalDebits",
    "totalCredits",
    "contactReference",
    "rateNote",
    "movements"
  ],
  "additionalProperties": false
}
