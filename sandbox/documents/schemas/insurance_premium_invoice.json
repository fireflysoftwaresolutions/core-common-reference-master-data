{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Premium invoice sandbox facts",
  "type": "object",
  "properties": {
    "documentReference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "issuedOn": {
      "type": "string",
      "format": "date"
    },
    "partyName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "resourceReference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "currency": {
      "const": "USD"
    },
    "invoiceNumber": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "policyNumber": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "dueDate": {
      "type": "string",
      "format": "date"
    },
    "subtotal": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]{2}$",
      "maxLength": 32
    },
    "tax": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]{2}$",
      "maxLength": 32
    },
    "total": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]{2}$",
      "maxLength": 32
    },
    "paid": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]{2}$",
      "maxLength": 32
    },
    "outstanding": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]{2}$",
      "maxLength": 32
    },
    "paymentReference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "paymentInstructions": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "charges": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "amount": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]{2}$",
            "maxLength": 32
          }
        },
        "required": [
          "description",
          "amount"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "documentReference",
    "issuedOn",
    "partyName",
    "resourceReference",
    "currency",
    "invoiceNumber",
    "policyNumber",
    "dueDate",
    "subtotal",
    "tax",
    "total",
    "paid",
    "outstanding",
    "paymentReference",
    "paymentInstructions",
    "charges"
  ],
  "additionalProperties": false
}
