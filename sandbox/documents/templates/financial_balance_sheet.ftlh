<section class="document-page">
<h1>Financial balance sheet</h1><p class="sandbox-label"><strong>Sandbox specimen</strong> · Fictional institution and customer data.</p><p class="document-reference">${facts.documentReference} · ${facts.issuedOn}</p>
<dl class="key-details"><div><dt>Reporting entity</dt><dd>${facts.partyName}</dd></div><div><dt>Reporting date</dt><dd>${facts.reportingDate}</dd></div><div><dt>Comparative date</dt><dd>${facts.comparativeDate}</dd></div><div><dt>Currency</dt><dd>${facts.currency}</dd></div></dl><h2>Statement of financial position</h2><table><thead><tr><th scope="col">${facts.currency}</th><th scope="col">${facts.reportingDate}</th><th scope="col">${facts.comparativeDate}</th></tr></thead><tbody><tr><th scope="row">Assets</th><td></td><td></td></tr><tr><td>Cash</td><td class="amount">${facts.current.cash?number?string["#,##0.00"]}</td><td class="amount">${facts.comparative.cash?number?string["#,##0.00"]}</td></tr><tr><td>Customer loans, net</td><td class="amount">${facts.current.customerLoans?number?string["#,##0.00"]}</td><td class="amount">${facts.comparative.customerLoans?number?string["#,##0.00"]}</td></tr><tr><td>Investments</td><td class="amount">${facts.current.investments?number?string["#,##0.00"]}</td><td class="amount">${facts.comparative.investments?number?string["#,##0.00"]}</td></tr><tr><td>Total assets</td><td class="amount">${facts.current.totalAssets?number?string["#,##0.00"]}</td><td class="amount">${facts.comparative.totalAssets?number?string["#,##0.00"]}</td></tr><tr><th scope="row">Liabilities</th><td></td><td></td></tr><tr><td>Customer deposits</td><td class="amount">${facts.current.customerDeposits?number?string["#,##0.00"]}</td><td class="amount">${facts.comparative.customerDeposits?number?string["#,##0.00"]}</td></tr><tr><td>Borrowings</td><td class="amount">${facts.current.borrowings?number?string["#,##0.00"]}</td><td class="amount">${facts.comparative.borrowings?number?string["#,##0.00"]}</td></tr><tr><td>Total liabilities</td><td class="amount">${facts.current.totalLiabilities?number?string["#,##0.00"]}</td><td class="amount">${facts.comparative.totalLiabilities?number?string["#,##0.00"]}</td></tr><tr><th scope="row">Equity</th><td></td><td></td></tr><tr><td>Share capital</td><td class="amount">${facts.current.shareCapital?number?string["#,##0.00"]}</td><td class="amount">${facts.comparative.shareCapital?number?string["#,##0.00"]}</td></tr><tr><td>Retained earnings</td><td class="amount">${facts.current.retainedEarnings?number?string["#,##0.00"]}</td><td class="amount">${facts.comparative.retainedEarnings?number?string["#,##0.00"]}</td></tr><tr><td>Total equity</td><td class="amount">${facts.current.totalEquity?number?string["#,##0.00"]}</td><td class="amount">${facts.comparative.totalEquity?number?string["#,##0.00"]}</td></tr><tr><td>Total liabilities and equity</td><td class="amount">${facts.current.totalLiabilitiesAndEquity?number?string["#,##0.00"]}</td><td class="amount">${facts.comparative.totalLiabilitiesAndEquity?number?string["#,##0.00"]}</td></tr></tbody></table>
