<section class="document-page">
<h1>Account ownership certificate</h1><p class="sandbox-label"><strong>Sandbox specimen</strong> · Fictional institution and customer data.</p><p class="document-reference">${facts.documentReference} · ${facts.issuedOn}</p>
<dl class="key-details"><div><dt>Named customer</dt><dd>${facts.partyName}</dd></div><div><dt>Account</dt><dd>${facts.accountNumber}</dd></div><div><dt>Account reference</dt><dd>${facts.accountReference}</dd></div><div><dt>Account type / status</dt><dd>Current account / Open</dd></div><div><dt>Currency</dt><dd>${facts.currency}</dd></div><div><dt>Opened on</dt><dd>${facts.openedOn}</dd></div><div><dt>Title as of</dt><dd>${facts.asOf}</dd></div><div><dt>Verification reference</dt><dd>${facts.verificationReference}</dd></div></dl><h2>Recorded holders</h2><table><thead><tr><th scope="col">Holder</th><th scope="col">Reference / role</th><th scope="col">Valid from</th></tr></thead><tbody><#list facts.holders as row><tr><td>${row.partyName}</td><td>${row.partyReference} / Account owner</td><td>${row.validFrom}</td></tr></#list></tbody></table>
